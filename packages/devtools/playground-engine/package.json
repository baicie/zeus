{
  "name": "@zeus-js/playground-engine",
  "type": "module",
  "version": "0.1.1-beta.20",
  "description": "Shared project and compiler bridge contracts for Zeus playgrounds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/zeus.git",
    "directory": "packages/devtools/playground-engine"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/playground-engine.d.ts",
      "module": "./dist/playground-engine.esm-bundler.js",
      "import": "./dist/playground-engine.esm-bundler.js",
      "require": {
        "production": "./dist/playground-engine.prod.cjs",
        "development": "./dist/playground-engine.cjs",
        "default": "./index.cjs"
      }
    }
  },
  "files": [
    "index.cjs",
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "author": "Baicie",
  "buildOptions": {
    "name": "ZeusPlaygroundEngine",
    "formats": [
      "esm-bundler",
      "cjs"
    ]
  },
  "keywords": [
    "zeus",
    "playground",
    "compiler",
    "project"
  ],
  "dependencies": {
    "@babel/parser": "catalog:",
    "@babel/standalone": "^8.1.1"
  },
  "main": "index.cjs",
  "module": "dist/playground-engine.esm-bundler.js",
  "types": "dist/playground-engine.d.ts"
}
