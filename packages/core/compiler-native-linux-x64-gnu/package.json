{
  "name": "@zeus-js/compiler-native-linux-x64-gnu",
  "version": "0.1.1-beta.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Zeus Rust compiler native binary for Linux x64 glibc",
  "license": "MIT",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
