      "require": "./package.json",
      "default": "./package.json"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "zeus-compiler-native.linux-x64-gnu.node",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/zeus",
    "directory": "packages/core/compiler-native-linux-x64-gnu"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
