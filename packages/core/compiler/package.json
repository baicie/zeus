{
  "name": "@zeus-js/compiler",
  "type": "module",
  "version": "0.1.1-beta.1",
  "description": "Rust-native Zeus compiler transform contract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/zeus.git",
    "directory": "packages/core/compiler"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/compiler.d.ts",
      "module": "./dist/compiler.esm-bundler.js",
      "import": "./dist/compiler.esm-bundler.js",
      "require": {
        "production": "./dist/compiler.prod.cjs",
        "development": "./dist/compiler.cjs",
        "default": "./index.cjs"
      }
    }
  },
  "files": [
    "index.cjs",
    "dist"
  ],
  "dependencies": {
    "@zeus-js/compiler-native": "workspace:*"
  },
  "author": "Baicie",
  "bugs": {
    "url": "https://github.com/baicie/zeus/issues"
  },
  "buildOptions": {
    "name": "ZeusCompiler",
    "formats": [
      "esm-bundler",
      "cjs"
    ]
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "homepage": "https://github.com/baicie/zeus/tree/main/packages/core/compiler#readme",
  "keywords": [
    "zeus",
    "compiler",
    "rust",
    "native"
  ],
  "main": "index.cjs",
  "module": "dist/compiler.esm-bundler.js",
  "types": "dist/compiler.d.ts"
}
