{
  "name": "@zeus-js/signal",
  "type": "module",
  "version": "0.1.1-beta.2",
  "description": "@zeus-js/signal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/zeus.git",
    "directory": "packages/core/signal"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/signal.d.ts",
      "module": "./dist/signal.esm-bundler.js",
      "import": "./dist/signal.esm-bundler.js",
      "require": {
        "production": "./dist/signal.prod.cjs",
        "development": "./dist/signal.cjs",
        "default": "./index.cjs"
      }
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": {
        "production": "./dist/internal.prod.cjs",
        "development": "./dist/internal.cjs",
        "default": "./internal.cjs"
      }
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "require": {
        "production": "./dist/diagnostics.prod.cjs",
        "development": "./dist/diagnostics.cjs",
        "default": "./diagnostics.cjs"
      }
    }
  },
  "files": [
    "index.cjs",
    "internal.cjs",
    "diagnostics.cjs",
    "dist"
  ],
  "dependencies": {
    "@zeus-js/shared": "workspace:*",
    "alien-signals": "^3.2.1"
  },
  "author": "Baicie",
  "bugs": {
    "url": "https://github.com/baicie/zeus/issues"
  },
  "buildOptions": {
    "name": "ZeusSignal",
    "external": [
      "@zeus-js/signal/internal"
    ],
    "formats": [
      "esm-bundler",
      "esm-browser",
      "cjs",
      "global"
    ],
    "additionalEntries": [
      {
        "entry": "internal.ts",
        "output": "dist/internal.js"
      },
      {
        "entry": "diagnostics.ts",
        "output": "dist/diagnostics.js"
      }
    ]
  },
  "homepage": "https://github.com/baicie/zeus/tree/main/packages/core/signal#readme",
  "jsdelivr": "dist/signal.global.js",
  "keywords": [
    "zeus"
  ],
  "main": "index.cjs",
  "module": "dist/signal.esm-bundler.js",
  "types": "dist/signal.d.ts",
  "unpkg": "dist/signal.global.js"
}
