{
  "name": "@zeus-js/bundler-plugin",
  "type": "module",
  "version": "0.1.1-beta.1",
  "description": "Zeus bundler plugin host",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/zeus.git",
    "directory": "packages/web-c/bundler-plugin"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/bundler-plugin.d.ts",
      "module": "./dist/bundler-plugin.esm-bundler.js",
      "import": "./dist/bundler-plugin.esm-bundler.js",
      "require": {
        "production": "./dist/bundler-plugin.prod.cjs",
        "development": "./dist/bundler-plugin.cjs",
        "default": "./index.cjs"
      }
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "import": "./dist/rolldown.js"
    },
    "./manifest": {
      "types": "./dist/outputPlugins/manifest.d.ts",
      "import": "./dist/outputPlugins/manifest.js"
    }
  },
  "files": [
    "index.cjs",
    "dist"
  ],
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "rollup": "^4.0.0",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@zeus-js/compiler-native": "workspace:*",
    "@zeus-js/component-analyzer": "workspace:*",
    "fast-glob": "^3.3.3",
    "picomatch": "^4.0.4",
    "typescript": "^6.0.3"
  },
  "author": "Baicie",
  "buildOptions": {
    "name": "ZeusBundlerPlugin",
    "formats": [
      "esm-bundler",
      "cjs"
    ],
    "additionalEntries": [
      {
        "entry": "vite.ts",
        "output": "dist/vite.js"
      },
      {
        "entry": "rollup.ts",
        "output": "dist/rollup.js"
      },
      {
        "entry": "rolldown.ts",
        "output": "dist/rolldown.js"
      },
      {
        "entry": "outputPlugins/manifest.ts",
        "output": "dist/outputPlugins/manifest.js"
      }
    ]
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "keywords": [
    "zeus",
    "vite",
    "rollup",
    "rolldown",
    "web-components"
  ],
  "main": "index.cjs",
  "module": "dist/bundler-plugin.esm-bundler.js",
  "types": "dist/bundler-plugin.d.ts"
}
