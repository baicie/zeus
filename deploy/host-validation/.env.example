# Copy to a private env file; never commit real secrets.
# All images must be referenced by immutable digest.
ZEUS_PLAYGROUND_IMAGE=registry.example.com/zeus-playground@sha256:REPLACE
ZEUS_ADMIN_IMAGE=registry.example.com/zeus-admin@sha256:REPLACE
ZEUS_AI_HOST_IMAGE=registry.example.com/zeus-ai-host@sha256:REPLACE
ZEUS_AI_WORKBENCH_IMAGE=registry.example.com/zeus-ai-workbench@sha256:REPLACE

ZEUS_PLAYGROUND_BIND=127.0.0.1
ZEUS_PLAYGROUND_HOST_PORT=8080
ZEUS_PLAYGROUND_SANDBOX_PORT=8081
ZEUS_ADMIN_BIND=127.0.0.1
ZEUS_ADMIN_PORT=8082
ZEUS_AI_WORKBENCH_BIND=127.0.0.1
ZEUS_AI_WORKBENCH_PORT=8083

ZEUS_ADMIN_EMAIL=acceptance@example.test
ZEUS_ADMIN_PASSWORD=
ZEUS_ADMIN_VIEWER_PASSWORD=
ZEUS_AI_WORKSPACE_ID=acceptance
ZEUS_AI_ORIGINS=https://ai.example.com

ZEUS_PLAYGROUND_MEM=256m
ZEUS_ADMIN_MEM=256m
ZEUS_AI_HOST_MEM=384m
ZEUS_AI_WORKBENCH_MEM=128m
